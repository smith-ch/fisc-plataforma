# Servidor
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Seguridad
JWT_SECRET=cambia-esta-clave-super-secreta
JWT_EXPIRES_IN=2h
# Proxies de confianza delante del API para leer la IP real (X-Forwarded-For): 0 en local, 1 detrás de Vercel/proxy
TRUST_PROXY=0
# Límite global de peticiones por IP y minuto (login, registro, seguimiento, leads y órdenes tienen límites propios más estrictos)
THROTTLE_LIMIT=300
# Bloqueo temporal de un correo tras N logins fallidos
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Usuario administrador inicial (se crea al primer arranque)
ADMIN_EMAIL=admin@fisc.com.do
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# Base de datos: sqlite (desarrollo) o postgres (producción)
DB_TYPE=sqlite
DB_SQLITE_PATH=data/plataforma.sqlite
# DB_TYPE=postgres
# DATABASE_URL=postgres://usuario:clave@localhost:5432/plataforma
# Si la base es compartida (p. ej. la misma de Concrebill), las tablas de la web
# viven en este esquema propio y no chocan con las suyas.
# DB_SCHEMA=fisc
# Proveedores como Supabase exigen TLS en la conexión directa.
# DB_SSL=true
DB_SYNCHRONIZE=true

# Archivos subidos (fotos de trabajos, comprobantes, logos)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Integración Concrebill (ERP / facturación con NCF)
# Con CONCREBILL_ENABLED=false la plataforma funciona en modo simulado y registra
# cada llamada en la bitácora de integración del panel administrativo.
CONCREBILL_ENABLED=false
CONCREBILL_BASE_URL=https://api.concrebill.com/v1
CONCREBILL_API_KEY=

# PayPal (se activará más adelante)
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Invalidación de la caché de la landing (mismo valor que REVALIDATE_SECRET del frontend).
# FRONTEND_URL (arriba) se usa como destino; si trae varias URLs se usa la primera.
# Sin secreto no se notifica y la landing se actualiza sola cada 5 minutos.
REVALIDATE_SECRET=cambia-este-secreto
