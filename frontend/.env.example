# URL interna del API NestJS (usada por el proxy de Next y el render del servidor)
API_URL=http://localhost:4000

# Secreto compartido con el API: permite que el panel invalide la caché de la landing
# (POST /api/revalidate). Debe ser el mismo valor que REVALIDATE_SECRET del backend.
REVALIDATE_SECRET=cambia-este-secreto
